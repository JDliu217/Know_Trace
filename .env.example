# =============================================================================
# 企业知识库后端 - 本地开发环境变量模板
# =============================================================================
#
# 使用方法：
#   1. 复制为 .env：        cp .env.example .env
#   2. 按需填写真实值：      vim .env
#   3. 启动前加载变量：
#        set -a; source .env; set +a
#      或在 IDEA 的 Run/Debug Configurations → Environment variables 中逐项填入
#
# 说明：
#   - 本文件所有变量在 application.yml 中都有 ${XXX:默认值} 形式的占位符，
#     未设置时使用 yml 里的默认值，因此只填你真正需要改的那几项即可。
#   - .env 已在 .gitignore 中忽略，切勿提交到仓库。
#   - Redis / RabbitMQ / MongoDB / Nacos 的连接地址目前直接写在对应模块的
#     application.yml 中（默认 127.0.0.1），需修改时请编辑对应 yml。
#
# =============================================================================

# -----------------------------------------------------------------------------
# 机器标识（多台电脑共用同一个 Nacos 时必填，每台需唯一）
# -----------------------------------------------------------------------------
# 用于 Nacos 服务注册时的实例分组隔离，不设置则退化为系统用户名。
COMPUTER_ID=dev01

# -----------------------------------------------------------------------------
# MySQL（7 个业务库所在实例）
# -----------------------------------------------------------------------------
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# -----------------------------------------------------------------------------
# JWT 签名密钥（生产环境务必替换为足够长的随机串）
# -----------------------------------------------------------------------------
# JWT_SECRET=please-change-this-to-a-long-random-secret

# -----------------------------------------------------------------------------
# 大模型（可选，不配置则 AI 功能不可用但服务可正常启动）
# -----------------------------------------------------------------------------
# --- 通义千问（默认模型）---
# 获取地址：https://dashscope.console.aliyun.com/
# 注意：DashScope 上不存在 "qwen3-max"，填错会返回 404 Model not exist
QWEN_API_KEY=
# QWEN_MODEL=qwen-max
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- DeepSeek（第二个可选模型）---
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# RAG（检索增强生成）
# -----------------------------------------------------------------------------
# RAG_ENABLED=true
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64
# RAG_EMBEDDING_MODEL=text-embedding-v3

# -----------------------------------------------------------------------------
# KAG（知识图谱增强生成）
# -----------------------------------------------------------------------------
# KAG_ENABLED=true
# KAG_MAX_HOPS=2
# KAG_EXTRACTION_BATCH_SIZE=5

# -----------------------------------------------------------------------------
# Elasticsearch / Neo4j 地址（默认为本机）
# -----------------------------------------------------------------------------
# ELASTICSEARCH_URIS=http://127.0.0.1:9200
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# 对象存储 RustFS（S3 兼容，仅 kb-file 依赖）
# -----------------------------------------------------------------------------
# 不配置则文件上传/下载不可用。密钥请在自己的 RustFS 实例上创建，勿复用示例值。
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# -----------------------------------------------------------------------------
# 邮箱 SMTP（用于账号激活与密码重置，可选）
# -----------------------------------------------------------------------------
# 以 163 邮箱为例：
#   1. 登录 mail.163.com
#   2. 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务
#   3. 获取「授权码」（不是登录密码）
#   4. 填入下方 MAIL_PASSWORD
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# QQ 邮箱：MAIL_HOST=smtp.qq.com / MAIL_PORT=465
# Gmail ：MAIL_HOST=smtp.gmail.com / MAIL_PORT=587（需使用 App Password）

# -----------------------------------------------------------------------------
# 前端地址（用于激活邮件与密码重置邮件中的链接）
# -----------------------------------------------------------------------------
# APP_FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# 可选：MinerU 文档解析服务（扫描件 / 复杂版面 PDF）
# -----------------------------------------------------------------------------
# MinerU 为独立 Python 服务，启用方式见 kb-document/application.yml 的 mineru 段；
# 未启用或调用失败时自动回退 Java 原生 PDFBox / POI 解析。
